{
  "manifest_version": 3,
  "name": "InsensitiveX Minimal",
  "version": "1.0",
  "description": "Disables the age assurance flow on X.",
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}